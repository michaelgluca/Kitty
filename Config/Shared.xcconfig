// Shared build settings, committed.
//
// Local.xcconfig holds the signing identity and is gitignored. The `?` makes the
// include optional, so a fresh clone builds for the simulator with no setup at all.
#include? "../Local.xcconfig"

IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator

// Swift 6 language mode with complete strict concurrency. The MainActor default and
// approachable concurrency are what make this practical for a UI-shaped app; this is
// the exact combination proven to build cleanly. See ADR-0001.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES

SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

PRODUCT_NAME = $(TARGET_NAME)
INFOPLIST_FILE = App/Kitty/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Overridden by Local.xcconfig when present.
PRODUCT_BUNDLE_IDENTIFIER = uk.co.example.safety
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
