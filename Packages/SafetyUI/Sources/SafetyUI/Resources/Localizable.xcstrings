{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "alert.body.header": {
      "comment": "First line of the message sent to trusted contacts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I need help."
          }
        }
      }
    },
    "alert.body.sentAt": {
      "comment": "%@ is the time the alert was composed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent %@"
          }
        }
      }
    },
    "alert.body.locationLink": {
      "comment": "%@ is a maps link.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where I am: %@"
          }
        }
      }
    },
    "alert.body.coordinates": {
      "comment": "%@ is a plain latitude and longitude, for recipients not on an iPhone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordinates: %@"
          }
        }
      }
    },
    "alert.body.locationUnavailable": {
      "comment": "Stated explicitly rather than omitted, so the recipient knows it is missing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My location is not available."
          }
        }
      }
    },
    "alert.body.battery": {
      "comment": "%@ is a battery percentage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone battery: %@"
          }
        }
      }
    },
    "alert.body.disclaimer": {
      "comment": "Makes clear to the recipient that no service was contacted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent by hand from Kitty G. This app does not contact emergency services."
          }
        }
      }
    },
    "tab.alert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert"
          }
        }
      }
    },
    "tab.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get help"
          }
        }
      }
    },
    "tab.nearby": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby"
          }
        }
      }
    },
    "tab.settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "alert.button.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert my contacts"
          }
        }
      }
    },
    "alert.button.accessibilityHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a message to your trusted contacts. You review it and send it yourself."
          }
        }
      }
    },
    "disclaimer.persistent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitty G does not contact emergency services. In an emergency, call 999."
          }
        }
      },
      "comment": "Shown in the UK only. Outside the UK, disclaimer.persistent.elsewhere is used instead."
    },
    "help.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get help"
          }
        }
      }
    },
    "help.section.emergency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaching 999"
          }
        }
      }
    },
    "help.section.services": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support services"
          }
        }
      }
    },
    "help.status.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open now"
          }
        }
      }
    },
    "help.status.closed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed now"
          }
        }
      }
    },
    "help.status.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check their website for hours"
          }
        }
      }
    },
    "help.coverage.unitedKingdom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UK"
          }
        }
      }
    },
    "help.coverage.england": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "England"
          }
        }
      }
    },
    "help.coverage.englandAndWales": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "England and Wales"
          }
        }
      }
    },
    "help.coverage.wales": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wales"
          }
        }
      }
    },
    "help.coverage.scotland": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scotland"
          }
        }
      }
    },
    "help.coverage.northernIreland": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Northern Ireland"
          }
        }
      }
    },
    "help.prerequisite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you can use this: %@"
          }
        }
      },
      "comment": "%@ is something the user must do in advance, such as registering for text-to-999."
    },
    "help.call": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call %@"
          }
        }
      },
      "comment": "%@ is a phone number."
    },
    "help.openWebsite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open website"
          }
        }
      }
    },
    "help.noPhone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This service has no phone line."
          }
        }
      }
    },
    "help.callConfirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call %@?"
          }
        }
      }
    },
    "help.callConfirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will open your phone app. Kitty G does not make the call for you."
          }
        }
      }
    },
    "help.callConfirm.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call"
          }
        }
      }
    },
    "help.callConfirm.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "help.callFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone could not start the call. You can dial %@ yourself."
          }
        }
      }
    },
    "region.notice.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written for the UK"
          }
        }
      }
    },
    "region.notice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitty G's helplines, police contacts and 999 guidance apply in the United Kingdom. Alerting your trusted contacts works anywhere. Check the emergency number where you are — in much of Europe it is 112."
          }
        }
      }
    },
    "region.notice.dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand"
          }
        }
      }
    },
    "region.notice.setUK": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am in the UK"
          }
        }
      }
    },
    "disclaimer.persistent.elsewhere": {
      "comment": "Shown outside the UK. Must NOT name 999, which does not work in most countries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitty G does not contact emergency services. In an emergency, call your local emergency number."
          }
        }
      }
    },
    "help.coverage.greatBritain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "England, Scotland and Wales"
          }
        }
      },
      "comment": "Great Britain. Deliberately spelled out: users may not know Northern Ireland is excluded."
    },
    "help.coverage.london": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "London"
          }
        }
      }
    },
    "help.audience": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For: %@"
          }
        }
      },
      "comment": "%@ is who the service is for, e.g. 'Women' or 'Aged 18 and over'."
    },
    "help.openInstructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Apple's instructions"
          }
        }
      }
    },
    "help.section.reporting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a crime"
          }
        }
      }
    },
    "help.reporting.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitty G never collects a report. These go straight to the police or to the charity, and are for when nobody is in danger. If someone is, call 999."
          }
        }
      }
    },
    "help.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text %@"
          }
        }
      },
      "comment": "%@ is a number to send a text message to. Never a call."
    },
    "help.textFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages could not open. You can text %@ yourself."
          }
        }
      }
    },
    "help.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "help.callConfirm.messageWithNumber": {
      "comment": "%@ is the exact number that will be dialled — taken from the same value the Call button uses.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will open your phone app to call %@. Kitty G does not make the call for you."
          }
        }
      }
    },
    "alert.body.testNotice": {
      "comment": "First line of a message composed in Test Mode, so the recipient knows it is not real.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TEST from Kitty G's Test Mode. Please ignore: nobody needs help."
          }
        }
      }
    },
    "testMode.banner.title": {
      "comment": "Heading of the banner shown while Test Mode is on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test Mode is on"
          }
        }
      }
    },
    "testMode.banner.body": {
      "comment": "Explains what Test Mode does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts, calls and texts go to numbers reserved for TV and film, which cannot reach anyone. Your contacts, helplines and 999 will not be contacted."
          }
        }
      }
    },
    "testMode.banner.turnOff": {
      "comment": "Button that switches Test Mode off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off Test Mode"
          }
        }
      }
    },
    "help.callConfirm.messageTestMode": {
      "comment": "%1$@ is the stand-in number that will be dialled; %2$@ is the service's real number, which will not be.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test Mode: this will call %1$@, a number reserved for TV and film, instead of %2$@. Nobody will answer."
          }
        }
      }
    },
    "alert.contacts.title": {
      "comment": "Heading of the row that opens the trusted-contact list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted contacts"
          }
        }
      }
    },
    "alert.contacts.none": {
      "comment": "Shown when there are no trusted contacts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one yet. Add the people your alert should go to."
          }
        }
      }
    },
    "alert.contacts.unreadable": {
      "comment": "Shown when the stored list cannot be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved contacts could not be read. Tap to fix this."
          }
        }
      }
    },
    "alert.contacts.add": {
      "comment": "Button that opens the trusted-contact list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a trusted contact"
          }
        }
      }
    },
    "alert.phase.locating": {
      "comment": "Shown for up to three seconds while a location is read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding where you are…"
          }
        }
      }
    },
    "alert.phase.composing": {
      "comment": "Shown while the Messages sheet is open.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the message, then tap Send."
          }
        }
      }
    },
    "alert.result.sent": {
      "comment": "After the person tapped Send. iOS reports nothing about delivery.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message was passed to Messages. Kitty G cannot confirm it was delivered."
          }
        }
      }
    },
    "alert.result.sent.withLocation": {
      "comment": "Follows alert.result.sent when a location was included.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It included where you are."
          }
        }
      }
    },
    "alert.result.sent.withoutLocation": {
      "comment": "Follows alert.result.sent when no usable location was available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It did not include your location."
          }
        }
      }
    },
    "alert.result.cancelled": {
      "comment": "After the person closed Messages without sending.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent. The message was closed without sending."
          }
        }
      }
    },
    "alert.result.failed": {
      "comment": "Followed by a button per trusted contact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message could not be sent. Try again, or call someone:"
          }
        }
      }
    },
    "alert.result.cannotText": {
      "comment": "Followed by a button per trusted contact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone cannot send text messages right now. There may be no SIM, or messaging may be restricted. Call someone instead:"
          }
        }
      }
    },
    "alert.result.needsContacts": {
      "comment": "Shown when the alert is raised with no trusted contacts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least one trusted contact first. Your alert goes only to people you choose."
          }
        }
      }
    },
    "alert.result.contactsUnreadable": {
      "comment": "Shown when the stored list cannot be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trusted contacts could not be read, so no message was prepared. Open Trusted contacts to fix this."
          }
        }
      }
    },
    "alert.result.dismiss": {
      "comment": "Clears the result message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "alert.callContact": {
      "comment": "%1$@ is a trusted contact's name; %2$@ is their number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call %1$@ (%2$@)"
          }
        }
      }
    },
    "alert.location.on": {
      "comment": "Location is allowed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your alert will include where you are."
          }
        }
      }
    },
    "alert.location.notDetermined": {
      "comment": "Location has not been asked for yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location so your alert can say where you are. Kitty G reads it only while you are using the app, and never sends it anywhere itself."
          }
        }
      }
    },
    "alert.location.allow": {
      "comment": "Button that shows the system location prompt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location"
          }
        }
      }
    },
    "alert.location.denied": {
      "comment": "Location was refused, or is off for the whole phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is off for Kitty G, so your alert will not say where you are."
          }
        }
      }
    },
    "alert.location.restricted": {
      "comment": "Location is blocked, for example by Screen Time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is restricted on this iPhone, so your alert will not say where you are."
          }
        }
      }
    },
    "alert.location.reduced": {
      "comment": "Only approximate location is allowed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise Location is off, so your alert cannot say exactly where you are."
          }
        }
      }
    },
    "alert.location.openSettings": {
      "comment": "Opens this app's page in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "alert.location.settingsFailed": {
      "comment": "Shown if the Settings app did not open.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be opened. Go to Settings, then Apps, then Kitty G, then Location."
          }
        }
      }
    },
    "emergency.call.buttonTestMode": {
      "comment": "%@ is the emergency number. In Test Mode the call goes to a drama number instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call %@ (Test Mode)"
          }
        }
      }
    },
    "emergency.call.hint": {
      "comment": "Accessibility hint on the 999 button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks you to confirm before your phone app opens."
          }
        }
      }
    },
    "emergency.confirm.message": {
      "comment": "%@ is the emergency number. Describes Advanced Mobile Location, which iOS does itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will open your phone app to call %@. Kitty G does not make the call for you. During the call, your iPhone automatically shares its location with the emergency services."
          }
        }
      }
    },
    "emergency.confirm.messageTestMode": {
      "comment": "%1$@ is the stand-in number; %2$@ is the emergency number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
